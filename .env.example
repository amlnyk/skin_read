# Names only, no values. Copy to .env.local (ignored by git) for local work.
# VITE_* variables are public and end up in the client bundle: never put secrets in them.
# Secrets are set only in Vercel (Production, Preview, Development separately).

# Client (public)
VITE_APP_ENV=
VITE_CONTENT_POLICY=
VITE_FEATURE_PHOTO_SCAN=
VITE_FEATURE_SIMPLIFY_AI=

# Server (api/), secrets
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ALLOWED_ORIGINS=
DAILY_LIMIT=
RATE_LIMIT_PER_HOUR=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOG_LEVEL=
